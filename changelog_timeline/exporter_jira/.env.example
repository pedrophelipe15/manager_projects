JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# JQL base para consultas (opcional se passar --jql na CLI)
JIRA_JQL_BASE=project = YOURPROJECT ORDER BY updated DESC

# Ajustes de extração
JIRA_PAGE_SIZE=100
JIRA_REQUEST_TIMEOUT_SECONDS=30

# Campos customizados (ajuste para seu Jira)
JIRA_STORY_POINTS_FIELD=customfield_10497
JIRA_START_DATE_FIELD=customfield_10015
JIRA_START_DATETIME_FIELD=customfield_10008
JIRA_DUE_DATE_FALLBACK_FIELD=customfield_10009
JIRA_TEAM_FIELD=customfield_10001
JIRA_EXECUTOR_TEAMS_FIELD=customfield_10104
JIRA_PAGSEGURO_TEAMS_FIELD=customfield_10173
JIRA_BUSINESS_UNIT_FIELD=customfield_10256
JIRA_SEVERITY_FIELD=customfield_10130
JIRA_UNAVAILABILITY_FIELD=customfield_10085
JIRA_REQUEST_TYPE_FIELD=customfield_10010
JIRA_QUARTER_FIELD=
JIRA_SERVICE_NAME_FIELD=
